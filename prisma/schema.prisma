// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// the admin that assigns a room to the student  and overlooks the application
model admin {
  id        String   @id @default(uuid())
  fullname  String
  email     String   @unique
  password  String
  telephone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model student {
  id              String        @id @default(uuid())
  studentId       String        @unique
  profile         String?
  fullName        String
  email           String?       @unique
  password        String
  gender          String
  resetCode       String?
  resetCodeExpiry DateTime?
  level           Int
  disabled        Boolean?      @default(false)
  telephone       String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  department      String?
  allocation      allocation?
  affilliate      String        @default("Autonomy")
  hall            hall?         @relation(fields: [hallId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hallId          String?
  Transaction     Transaction[]
  chat            Chat[]
}

model allocation {
  id          String        @id @default(uuid())
  student     student       @relation(fields: [studentId], references: [studentId])
  studentId   String        @unique
  rooms       rooms         @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roomId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Transaction Transaction[]
}

model floors {
  id        String   @id @default(uuid())
  number    Int
  rooms     rooms[]
  blocks    blocks?  @relation(fields: [blocksId], references: [id])
  blocksId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model blocks {
  id        String   @id @default(uuid())
  name      String   @unique
  floors    floors[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model rooms {
  id              String       @id @default(uuid())
  number          Int
  status          stats
  floors          floors?      @relation(fields: [floorId], references: [id])
  floorId         String?
  total_occupants Int          @default(0)
  max_occupants   Int          @default(4)
  allocation      allocation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Transaction {
  id           String      @id @default(uuid())
  amount       String
  student      student?    @relation(fields: [studentId], references: [id])
  studentId    String?
  allocation   allocation? @relation(fields: [allocationId], references: [id])
  allocationId String?
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())
}

model contactUs {
  id                 String   @id @default(uuid())
  full_name          String
  room_number        Int
  complaint_category String
  imgUrl             String?
  description        String
  createdAt          DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  message   String
  student   student? @relation(fields: [studentId], references: [studentId])
  studentId String?
  global    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model hall {
  id        String    @id @default(uuid())
  name      String
  location  String
  student   student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum stats {
  Available
  Not_Available
}

enum options {
  Rejected
  Approved
  Pending
}
